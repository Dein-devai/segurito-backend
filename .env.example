# =============================================================================
# Segurito — Configuración de entorno
# =============================================================================
# Todas las variables son OPCIONALES excepto ANTHROPIC_API_KEY. Los defaults
# están definidos en backend/settings.py.
# =============================================================================

# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Cascada multi-modelo (Haiku → Sonnet → Opus) ----------------------------
SEGURITO_MODEL_TRIAGE=claude-haiku-4-5
SEGURITO_MODEL_DEFAULT=claude-sonnet-4-5
SEGURITO_MODEL_ESCALATION=claude-opus-4-6
SEGURITO_ENABLE_TRIAGE=true
SEGURITO_ENABLE_PROMPT_CACHE=true
SEGURITO_ALLOW_MODEL_OVERRIDE=false
SEGURITO_THINKING_BUDGET=2048
# JSON list. Si la query contiene alguno, se escala a Opus.
SEGURITO_ESCALATION_KEYWORDS=["demanda","tribunal","fraude grande","estafa millonaria","insider","información privilegiada","acción legal","querella"]

# --- Rate limits transversales (token bucket) --------------------------------
SEGURITO_RL_IP_MIN=60
SEGURITO_RL_IP_DAY=1000
SEGURITO_RL_CONV_HOUR=120
SEGURITO_RL_SONNET_MIN=40
SEGURITO_RL_OPUS_MIN_GLOBAL=10
SEGURITO_RL_OPUS_CONV=5

# --- Cost guard --------------------------------------------------------------
SEGURITO_COST_BUDGET_DAY_USD=10.0

# --- Tool loop ---------------------------------------------------------------
SEGURITO_MAX_TOOL_ITERATIONS=5
SEGURITO_TOOL_LOOP_TIMEOUT=30
SEGURITO_MAX_USER_INPUT=2000

# --- Plugins / API -----------------------------------------------------------
SEGURITO_ENABLED_ORGANISMOS=["cmf","legal","sernac","sii"]
SEGURITO_CORS_ORIGINS=["*"]
SEGURITO_LOG_LEVEL=INFO
SEGURITO_CONVERSATION_TTL=1800

# --- MCP server --------------------------------------------------------------
SEGURITO_MCP_HOST=127.0.0.1
SEGURITO_MCP_PORT=8765
